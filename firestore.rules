rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // دالة مساعدة: التحقق من أن الطلب قادم من المستخدم المسجل دخولا
    function isAuthenticated() {
      return request.auth != null;
    }

    // دالة مساعدة: التحقق من أن الطلب قادم من الخادم المركزي (Admin SDK)
    function isServer() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'google.com'; 
    }

    // دالة مساعدة: جلب وتحقق الدور التشغيلي للمستخدم من قاعدة البيانات لتجنب تعارض الهويات
    function hasRole(roleName) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == roleName;
    }

    // دالة مساعدة: التحقق من أن الطلب قادم من مشرف أو مالك النظام
    function isAdmin() {
      return hasRole('admin') || hasRole('owner');
    }

    // دالة مساعدة: التحقق من أن المندوب يملك مستند المندوب المطابق لبيانات التسجيل الخاصة به
    function isDelegateDocOwner(docData) {
      return isAuthenticated() && 
             hasRole('delegate') &&
             docData != null && (
               docData.id == request.auth.uid ||
               (docData.data != null && (
                 docData.data.userId == request.auth.uid ||
                 (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
                  docData.data.phone == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone)
               ))
             );
    }

    // ==========================================
    // قواعد المستخدمين والكيانات القياسية (Standard Collections)
    // ==========================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin() ||
        isServer() ||
        (hasRole('rider') && resource != null && 'role' in resource.data && resource.data.role == 'driver') ||
        (hasRole('driver') && resource != null && 'role' in resource.data && resource.data.role == 'rider')
      );
      allow create: if isAdmin() || isServer() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == 'rider') &&
        !request.resource.data.keys().hasAny([
          'isBanned', 'banReason', 'immunityScore', 'paidHoursRemaining',
          'subscriptionHours', 'pendingDues', 'reviveSovereignToken',
          'revivedByAdminId', 'allowedSectors'
        ])
      );
      allow update: if isAdmin() || isServer() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isBanned', 'banReason', 'immunityScore', 'paidHoursRemaining',
          'subscriptionHours', 'pendingDues', 'reviveSovereignToken',
          'revivedByAdminId', 'status', 'rating', 'heartCount', 'allowedSectors'
        ])
      );
      allow delete: if isAdmin() || isServer();
    }

    match /promos/{promoId} {
      allow read: if true;
      allow write: if isServer() || isAdmin(); // المشرف أو السيرفر فقط يدير الإعلانات المركزية
    }

    match /delegates/{delegateId} {
      allow read, list: if isAdmin() || isServer() || isDelegateDocOwner(resource);
      allow create, delete: if isAdmin() || isServer();
      allow update: if isAdmin() || isServer() || (
        isDelegateDocOwner(resource) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'pendingDues', 'referredCount', 'integritySignature',
          'status', 'deletionRate', 'revivalRate', 'settledBalances'
        ])
      );
    }

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isServer() || isAdmin(); // السيرفر أو المشرف يملك تعديل إعدادات النظام السيادي
    }

    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow write: if isServer(); // حظر التلاعب: السيرفر يحقن ويفحص المركبات بعد مطابقة التراخيص
    }

    match /silent_reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, write: if false; // عزل كامل للتقارير الجنائية الصامتة
    }

    // ==========================================
    // 1. قواعد مستندات الرحلات السيادية (Trips Collection)
    // ==========================================
    match /trips/{tripId} {
      // القراءة: مقصورة على أطراف الرحلة والمشرفين، أو السائقين أثناء البحث/العرض النشط
      allow read: if isAdmin() || isServer() || (
        isAuthenticated() && resource != null && (
          resource.data.riderId == request.auth.uid ||
          resource.data.driverId == request.auth.uid ||
          resource.data.captainId == request.auth.uid ||
          (hasRole('driver') && resource.data.status in ['pending', 'searching'])
        )
      );

      // الإنشاء: مقصور على الراكب المنشئ في حالة البداية أو الخادم/المشرف
      allow create: if isAdmin() || isServer() || (
        isAuthenticated() &&
        request.resource.data.riderId == request.auth.uid &&
        request.resource.data.status in ['pending', 'searching']
      );

      // التحديث: مقصور على أطراف الرحلة والمشرفين أو قبول كابتن لطلب مفتوح (دون تغيير هوية الراكب)
      allow update: if isAdmin() || isServer() || (
        isAuthenticated() && resource != null &&
        request.resource.data.riderId == resource.data.riderId && (
          resource.data.riderId == request.auth.uid ||
          resource.data.driverId == request.auth.uid ||
          resource.data.captainId == request.auth.uid ||
          (hasRole('driver') && resource.data.status in ['pending', 'searching'])
        )
      );

      // الحذف: مجمد ومحصن؛ لا يتم حذف أي رحلة، بل تحول حالتها برمجيا فقط
      allow delete: if false;
    }

    // ==========================================
    // 9. قواعد العدادات الرقمية المتسلسلة وقسائم الشحن (System Counters & Vouchers)
    // ==========================================
    match /system_counters/{counterId} {
      allow read, write: if isAdmin() || isServer();
    }

    match /wallet_vouchers/{voucherId} {
      allow read, write: if isAdmin() || isServer();
    }

    // ==========================================
    // 2. قواعد رادار السائقين وملخص السوق (Market Pulse)
    // ==========================================
    match /market_pulse/{document=**} {
      // التزاما بـ (SC55): السائق يقرأ فقط (1 Read) ويمنع العميل من الكتابة أو التعديل
      allow read: if isAuthenticated();
      allow write: if isServer(); // السيرفر المركزي وحده يحقن نبض الصعود والهبوط
    }

    match /driver_radars/{driverId} {
      // السائق يقرأ راداره الخاص، ويمنع المناديب والجهات غير المخولة من تتبع الكباتن.
      allow read: if isAuthenticated() && (
        request.auth.uid == driverId ||
        isAdmin() ||
        isServer()
      );
      // التحديث الجغرافي: العميل ينشئ/يحدث إحداثياته فقط، ويمنع من تزوير الهوية أو السعر
      allow create: if isAuthenticated() && request.auth.uid == driverId &&
                    !request.resource.data.keys().hasAny(['pricingIdentity', 'rating']);
      allow update: if isAuthenticated() && request.auth.uid == driverId &&
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pricingIdentity', 'rating']);
      allow delete: if isAdmin() || isServer();
    }

    // ==========================================
    // 3. قواعد الحظر التقني وكوابح العمليات (Limits 12/9)
    // ==========================================
    match /user_metrics/{userId} {
      // مستند يحسب عدد الطلبات النشطة لمنع منحنى الهدر المالي
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // السيرفر وحده هو من يملك سلطة تصفير أو زيادة عداد العمليات (12 للناقل / 9 للراكب)
      allow write: if isServer();
    }

    // ==========================================
    // 4. دفتر الأستاذ المحاسبي الجنائي المشفر (Immutable Audit Ledger)
    // ==========================================
    match /audit_ledger/{ledgerId} {
      allow create: if isAdmin() || isServer();
      allow read: if isAdmin() || isServer();
      allow update, delete: if false;
    }

    // ==========================================
    // 5. قواعد الإشعارات الفورية الديكتاتورية المباشرة (Sovereign Pushes)
    // ==========================================
    match /sovereign_pushes/{pushId} {
      allow read: if isAdmin() || isServer() || (
        isAuthenticated() && resource != null && (
          resource.data.targetUid == request.auth.uid ||
          resource.data.userId == request.auth.uid ||
          resource.data.senderUid == request.auth.uid
        )
      );
      allow create: if isAdmin() || isServer() || (
        isAuthenticated() &&
        request.resource.data.senderUid == request.auth.uid
      );
      allow update, delete: if isServer() || isAdmin();
    }

    // ==========================================
    // 6. قواعد غرف الدردشة غير المستدامة والقصيرة المدى (Ephemeral Chats)
    // ==========================================
    match /sovereign_ephemeral_chats/{chatId} {
      allow read: if isAdmin() || isServer() || (
        isAuthenticated() && resource != null && (
          resource.data.senderUid == request.auth.uid ||
          resource.data.recipientUid == request.auth.uid ||
          (resource.data.participants is list && request.auth.uid in resource.data.participants)
        )
      );
      allow create: if isAdmin() || isServer() || (
        isAuthenticated() &&
        request.resource.data.senderUid == request.auth.uid
      );
      allow update, delete: if isServer() || isAdmin();
    }

    // ==========================================
    // 7. قواعد روابط الوصول المؤقتة (Magic Links)
    // ==========================================
    match /delegate_links/{linkId} {
      allow read, list, create, update, delete: if isAdmin() || isServer();
    }

    // ==========================================
    // 8. قواعد المهام الميدانية للوكلاء (Delegate Tasks)
    // ==========================================
    match /delegate_tasks/{taskId} {
      allow read, list: if isAdmin() || isServer() || (
        isAuthenticated() &&
        resource != null &&
        resource.data != null &&
        resource.data.delegateId == request.auth.uid
      );
      allow create: if isAdmin() || isServer();
      allow update: if isAdmin() || isServer() || (
        isAuthenticated() &&
        resource != null &&
        resource.data != null &&
        resource.data.delegateId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        (request.resource.data.status == 'acknowledged' || request.resource.data.status == 'completed')
      );
      allow delete: if isAdmin() || isServer();
    }
  }
}
