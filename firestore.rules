rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // دالة مساعدة: التحقق من أن الطلب قادم من المستخدم المسجل دخولاً
    function isAuthenticated() {
      return request.auth != null;
    }

    // دالة مساعدة: التحقق من أن الطلب قادم من الخادم المركزي (Admin SDK)
    function isServer() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'google.com'; 
    }

    // دالة مساعدة: جلب وتحقق الدور التشغيلي للمستخدم من قاعدة البيانات لتجنب تعارض الهويات
    function hasRole(roleName) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == roleName;
    }

    // دالة مساعدة: التحقق من أن الطلب قادم من مشرف أو مالك النظام
    function isAdmin() {
      return hasRole('admin') || hasRole('owner');
    }

    // دالة مساعدة: التحقق من أن المندوب يملك مستند المندوب المطابق لبيانات التسجيل الخاصة به
    function isDelegateDocOwner(docData) {
      return isAuthenticated() && 
             hasRole('delegate') &&
             docData != null && (
               docData.id == request.auth.uid ||
               (docData.data != null && (
                 docData.data.userId == request.auth.uid ||
                 (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
                  docData.data.phone == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone)
               ))
             );
    }

    // ==========================================
    // قواعد المستخدمين والكيانات القياسية (Standard Collections)
    // ==========================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId 
                    && (!('name' in request.resource.data) || request.resource.data.name.size() < 100)
                    && (!('bio' in request.resource.data) || request.resource.data.bio.size() < 250)
                    // منع تصعيد الصلاحيات وتغيير الدور تلقائياً عبر الواجهة دون ختم مشفر
                    && (resource == null || !('role' in request.resource.data) || request.resource.data.role == resource.data.role || isAdmin() || request.auth.token.firebase.sign_in_provider == 'anonymous');
    }

    match /promos/{promoId} {
      allow read: if true;
      allow write: if isServer() || isAdmin(); // المشرف أو السيرفر يدير الحملات الترويجية والإعلانات
    }

    match /delegates/{delegateId} {
      allow read, list: if isAdmin() || isServer() || isDelegateDocOwner(resource);
      allow write: if isAdmin() || isServer() || isDelegateDocOwner(resource) || isDelegateDocOwner(request.resource);
    }

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isServer() || isAdmin(); // السيرفر أو المشرف يملك تعديل إعدادات النظام السيادي
    }

    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow write: if isServer(); // حظر التلاعب: السيرفر يحقن ويفحص المركبات بعد مطابقة التراخيص
    }

    match /silent_reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, write: if false; // عزل كامل للتقارير الجنائية الصامتة
    }

    // ==========================================
    // 1. قواعد مستندات الرحلات السيادية (Trips Collection)
    // ==========================================
    match /trips/{tripId} {
      
      // القراءة: مسموحة للراكب وصاحب الرحلة أو السائقين في المحيط (ضمن كوابح التشغيل)
      allow read: if isAuthenticated();

      // الإنشاء: يُحظر تماماً على العميل إنشاء رحلة مباشرة ببيانات من عنده
      // يجب أن تتم عبر POST /api/sovereign/trip/request
      allow create: if isServer();

      // التحديث: قواعد صارمة تمنع التلاعب بالسعر أو الوقت
      allow update: if isAuthenticated() && (
        // إذا كان التحديث قادماً من السيرفر، يُسمح بكل شيء لقفل العقد
        isServer() || 
        (
          // إذا كان التحديث من العميل (الراكب أو السائق)، يُسمح فقط بتغيير حقول غير حساسة
          // ويُمنع منعاً باتاً تعديل السعر (Price Snapshot) أو الطوابع الزمنية للرحلة
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['price', 'createdAt', 'matchedAt', 'geoAnchor'])
          && resource.data.status != 'COMPLETED' // يُمنع تعديل أي رحلة منتهية ومقفلة دستورياً
        )
      );

      // الحذف: مجمد ومحصن؛ لا يتم حذف أي رحلة، بل تحول حالتها برمجياً فقط
      allow delete: if false;
    }

    // ==========================================
    // 2. قواعد رادار السائقين وملخص السوق (Market Pulse)
    // ==========================================
    match /market_pulse/{document=**} {
      // التزاماً بـ (SC55): السائق يقرأ فقط (1 Read) ويُمنع العميل من الكتابة أو التعديل
      allow read: if isAuthenticated();
      allow write: if isServer(); // السيرفر المركزي وحده يحقن نبض الصعود والهبوط
    }

    match /driver_radars/{driverId} {
      // السائق يقرأ راداره الخاص، والراكب القريب يرى الإزاحة الجغرافية فقط
      allow read: if isAuthenticated();
      // التحديث الجغرافي: العميل يحدّث إحداثياته فقط، ويُمنع من تزوير الهوية أو السعر
      allow write: if isAuthenticated() && request.auth.uid == driverId && 
                    !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pricingIdentity', 'rating']);
    }

    // ==========================================
    // 3. قواعد الحظر التقني وكوابح العمليات (Limits 12/9)
    // ==========================================
    match /user_metrics/{userId} {
      // مستند يحسب عدد الطلبات النشطة لمنع منحنى الهدر المالي
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // السيرفر وحده هو من يملك سلطة تصفير أو زيادة عداد العمليات (12 للناقل / 9 للراكب)
      allow write: if isServer();
    }

    // ==========================================
    // 4. دفتر الأستاذ المحاسبي الجنائي المشفر (Immutable Audit Ledger)
    // ==========================================
    match /audit_ledger/{ledgerId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin() || isServer();
      allow update, delete: if false;
    }

    // ==========================================
    // 5. قواعد الإشعارات الفورية الديكتاتورية المباشرة (Sovereign Pushes)
    // ==========================================
    match /sovereign_pushes/{pushId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isServer() || isAdmin();
    }

    // ==========================================
    // 6. قواعد غرف الدردشة غير المستدامة والقصيرة المدى (Ephemeral Chats)
    // ==========================================
    match /sovereign_ephemeral_chats/{chatId} {
      allow read, write: if isAuthenticated();
    }

    // ==========================================
    // 7. قواعد روابط الوصول المؤقتة (Magic Links)
    // ==========================================
    match /delegate_links/{linkId} {
      allow read, list: if true;
      allow create: if isAdmin() || isServer();
      allow update: if isAdmin() || isServer() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status == 'used'
      );
      allow delete: if isAdmin() || isServer();
    }

    // ==========================================
    // 8. قواعد المهام الميدانية للوكلاء (Delegate Tasks)
    // ==========================================
    match /delegate_tasks/{taskId} {
      allow read, list: if isAdmin() || isServer() || (
        isAuthenticated() &&
        resource != null &&
        resource.data != null &&
        resource.data.delegateId == request.auth.uid
      );
      allow create: if isAdmin() || isServer();
      allow update: if isAdmin() || isServer() || (
        isAuthenticated() &&
        resource != null &&
        resource.data != null &&
        resource.data.delegateId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        (request.resource.data.status == 'acknowledged' || request.resource.data.status == 'completed')
      );
      allow delete: if isAdmin() || isServer();
    }
  }
}
