{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/components/ui/*": [
        "./src/shared/components/ui/*"
      ],
      "@/components/providers/*": [
        "./src/shared/components/providers/*"
      ],
      "@/components/shared/*": [
        "./src/shared/components/*"
      ],
      "@/hooks/use-dashboard-language": [
        "./src/shared/hooks/use-dashboard-language"
      ],
      "@/hooks/use-toast": [
        "./src/shared/hooks/use-toast"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "functions",
    "src/functions",
    "src/ai"
  ]
}
